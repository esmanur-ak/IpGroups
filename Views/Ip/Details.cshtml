@model IpGroups.Models.ViewModels.IpViewModel

@{
    ViewData["Title"] = "Alt IP Adresleri";
    var ipAddresses = ViewBag.IpAddresses as List<IpGroups.Models.ViewModels.IpAddressViewModel> ?? new List<IpGroups.Models.ViewModels.IpAddressViewModel>();
    var assigned = ipAddresses.Count(ia => ia.IsAssigned);
    var free = ipAddresses.Count(ia => !ia.IsAssigned);
}

<!-- Özet İstatistik Kartları -->
<div class="row mb-3">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body py-3 d-flex align-items-center justify-content-between">
                <div>
                    <p class="mb-0 text-muted">Toplam Alt IP</p>
                    <h3 class="mb-0 font-weight-bold text-info">@ipAddresses.Count</h3>
                </div>
                <i class="fa fa-network-wired fa-2x text-info opacity-75"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body py-3 d-flex align-items-center justify-content-between">
                <div>
                    <p class="mb-0 text-muted">Atanmış IP</p>
                    <h3 class="mb-0 font-weight-bold text-danger">@assigned</h3>
                </div>
                <i class="fa fa-user-check fa-2x text-danger opacity-75"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body py-3 d-flex align-items-center justify-content-between">
                <div>
                    <p class="mb-0 text-muted">Boşta IP</p>
                    <h3 class="mb-0 font-weight-bold text-success">@free</h3>
                </div>
                <i class="fa fa-check-circle fa-2x text-success opacity-75"></i>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h4 class="card-title mb-1">Alt IP Adresleri</h4>
                        <p class="card-description mb-0">
                            <span class="text-muted">@Model.IpNo</span> grubuna ait tüm alt IP adresleri (0-254)
                        </p>
                    </div>
                    <div id="header-buttons">
                        <button type="button" class="btn btn-warning text-white btn-icon-text mr-2 btn-edit" data-id="@Model.Id">
                            <i class="fa fa-edit btn-icon-prepend"></i> Düzenle
                        </button>
                        <a asp-action="Index" class="btn btn-light btn-icon-text">
                            <i class="fa fa-arrow-left btn-icon-prepend"></i> Geri Dön
                        </a>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-hover data-table">
                        <thead>
                            <tr>
                                <th>Oktet</th>
                                <th>IP Adresi</th>
                                <th>Durum</th>
                                <th>Oluşturulma Tarihi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ipAddresses.Any())
                            {
                                @foreach (var item in ipAddresses)
                                {
                                    <tr>
                                        <td>@item.Octet</td>
                                        <td>@item.FullIpAddress</td>
                                        <td>
                                            @if (item.IsAssigned)
                                            {
                                                <span class="badge badge-danger">Atanmış</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-success">Boşta</span>
                                            }
                                        </td>
                                        <td>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center">Alt IP adresi bulunamadı.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ======================== DÜZENLE MODAL ======================== -->
<div class="modal fade" id="editModal" tabindex="-1" role="dialog" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title" id="editModalLabel">
                    <i class="fa fa-edit mr-2"></i> IP Düzenle
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Kapat">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="editForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="edit_Id" name="Id" />
                <div class="modal-body">
                    <div id="editErrors" class="alert alert-danger d-none"></div>
                    <div class="d-flex justify-content-center py-3" id="editLoading">
                        <div class="spinner-border text-warning" role="status">
                            <span class="sr-only">Yükleniyor...</span>
                        </div>
                    </div>
                    <div id="editFormFields" class="d-none">
                        <div class="form-group">
                            <label for="edit_IpNo">IP No <span class="text-danger">*</span></label>
                            <input type="text" id="edit_IpNo" name="IpNo" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label for="edit_Description">Açıklama</label>
                            <textarea id="edit_Description" name="Description" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-warning text-white" id="editSubmitBtn">
                        <i class="fa fa-save mr-1"></i> Güncelle
                    </button>
                    <button type="button" class="btn btn-light" data-dismiss="modal">
                        <i class="fa fa-times mr-1"></i> İptal
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var antiForgeryToken = $('input[name="__RequestVerificationToken"]').first().val();

            // Move buttons to datatables filter
            setTimeout(function() {
                var btns = $('#header-buttons').detach();
                btns.addClass('ml-3');
                var filterDiv = $('.dataTables_filter');
                filterDiv.addClass('d-flex align-items-center justify-content-end');
                filterDiv.find('label').addClass('mb-0 d-flex align-items-center');
                filterDiv.find('input').addClass('ml-2');
                filterDiv.append(btns);
            }, 100);

            // ===================== DÜZENLE =====================
            $(document).on('click', '.btn-edit', function () {
                var id = $(this).data('id');
                $('#editErrors').addClass('d-none').empty();
                $('#editLoading').removeClass('d-none');
                $('#editFormFields').addClass('d-none');
                $('#editModal').modal('show');

                $.ajax({
                    url: '/Ip/GetEdit/' + id,
                    type: 'GET',
                    success: function (res) {
                        if (res.success) {
                            $('#edit_Id').val(res.id);
                            $('#edit_IpNo').val(res.ipNo);
                            $('#edit_Description').val(res.description);
                            $('#editLoading').addClass('d-none');
                            $('#editFormFields').removeClass('d-none');
                        } else {
                            $('#editModal').modal('hide');
                            alert(res.message || 'Kayıt yüklenemedi.');
                        }
                    },
                    error: function () {
                        $('#editModal').modal('hide');
                        alert('Bir hata oluştu.');
                    }
                });
            });

            $('#editForm').on('submit', function (e) {
                e.preventDefault();
                var id = $('#edit_Id').val();
                var btn = $('#editSubmitBtn');
                btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin mr-1"></i> Güncelleniyor...');
                $('#editErrors').addClass('d-none').empty();

                $.ajax({
                    url: '/Ip/Edit/' + id,
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (res) {
                        if (res.success) {
                            $('#editModal').modal('hide');
                            location.reload();
                        } else {
                            $('#editErrors').removeClass('d-none').html(res.errors.join('<br>'));
                        }
                    },
                    error: function () {
                        $('#editErrors').removeClass('d-none').html('Bir hata oluştu, lütfen tekrar deneyin.');
                    },
                    complete: function () {
                        btn.prop('disabled', false).html('<i class="fa fa-save mr-1"></i> Güncelle');
                    }
                });
            });
        });
    </script>
}
