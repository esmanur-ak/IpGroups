@using Microsoft.AspNetCore.Identity
@using IpGroups.Models.Entities
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

@* Melody Admin - Top Navbar *@
<nav class="navbar col-lg-12 col-12 p-0 fixed-top d-flex flex-row default-layout-navbar">
  <div class="text-center navbar-brand-wrapper d-flex align-items-center justify-content-center">
    <a class="navbar-brand brand-logo" asp-controller="Home" asp-action="Index">
      <img src="~/images/logo-dark.svg" alt="IpGroups" style="height:34px; max-width:160px; width:auto; vertical-align:middle; display:inline-block;"/>
    </a>
    <a class="navbar-brand brand-logo-mini" asp-controller="Home" asp-action="Index">
      <img src="~/images/logo-mini.svg" alt="IpGroups" style="height:30px; width:auto; vertical-align:middle; display:inline-block;"/>
    </a>
  </div>
  <div class="navbar-menu-wrapper d-flex align-items-stretch">
    <button class="navbar-toggler navbar-toggler align-self-center" type="button" data-toggle="minimize">
      <span class="fas fa-bars"></span>
    </button>

    <ul class="navbar-nav navbar-nav-right">
      @if (SignInManager.IsSignedIn(User))
      {
        var user = await UserManager.GetUserAsync(User);
        var displayName = user?.AdSoyad ?? User.Identity?.Name ?? "Kullanıcı";
        var isFemale = user?.Gender == "Kadın";
        var avatarUrl = !string.IsNullOrEmpty(user?.ProfilePictureUrl)
            ? user.ProfilePictureUrl
            : (isFemale ? "/images/female-avatar.png" : "/images/male-avatar.png");

        <li class="nav-item dropdown">
          <a class="nav-link count-indicator dropdown-toggle" id="notificationDropdown" href="#" data-toggle="dropdown">
            <i class="fas fa-bell mx-0"></i>
          </a>
          <div class="dropdown-menu dropdown-menu-right navbar-dropdown preview-list" aria-labelledby="notificationDropdown">
            <a class="dropdown-item">
              <p class="mb-0 font-weight-normal float-left">Bildirimler</p>
            </a>
          </div>
        </li>
        <li class="nav-item nav-profile dropdown">
          <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" data-toggle="dropdown" id="profileDropdown">
            <span class="nav-profile-name mr-2 font-weight-medium">@displayName</span>
            <img src="@avatarUrl" alt="profile"/>
          </a>
          <div class="dropdown-menu dropdown-menu-right navbar-dropdown" aria-labelledby="profileDropdown">
            <div class="dropdown-header text-center">
              <a asp-controller="Account" asp-action="Profile" class="text-dark text-decoration-none">
                <p class="mb-1 font-weight-bold">@displayName</p>
              </a>
              <p class="text-muted mb-0 small">@User.Identity?.Name</p>
            </div>
            <div class="dropdown-divider"></div>
            <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" class="d-inline">
              @Html.AntiForgeryToken()
              <button type="submit" class="dropdown-item text-danger border-0 bg-transparent w-100 text-left">
                <i class="fas fa-power-off text-danger mr-2"></i> Çıkış Yap
              </button>
            </form>
          </div>
        </li>
      }
      else
      {
        <li class="nav-item">
          <a class="nav-link btn btn-outline-primary btn-sm px-3 mr-2" asp-controller="Account" asp-action="Login">
            <i class="fas fa-sign-in-alt mr-1"></i> Giriş Yap
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link btn btn-primary btn-sm px-3 text-white" asp-controller="Account" asp-action="Register">
            <i class="fas fa-user-plus mr-1"></i> Kayıt Ol
          </a>
        </li>
      }
    </ul>
    <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" type="button" data-toggle="offcanvas">
      <span class="fas fa-bars"></span>
    </button>
  </div>
</nav>
