@model IpGroups.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var birimLabels = System.Text.Json.JsonSerializer.Serialize(
        Model.PersonelByBirim.Select(x => x.BirimAdi).ToList());
    var birimData = System.Text.Json.JsonSerializer.Serialize(
        Model.PersonelByBirim.Select(x => x.PersonelSayisi).ToList());

    var monthLabels = System.Text.Json.JsonSerializer.Serialize(
        Model.PersonelByMonth.Select(x => x.Ay).ToList());
    var monthData = System.Text.Json.JsonSerializer.Serialize(
        Model.PersonelByMonth.Select(x => x.PersonelSayisi).ToList());

    var ipGroupLabels = System.Text.Json.JsonSerializer.Serialize(
        Model.IpGroupOccupancies.Select(x => x.IpNo).ToList());
    var ipGroupTotalData = System.Text.Json.JsonSerializer.Serialize(
        Model.IpGroupOccupancies.Select(x => x.TotalCapacity).ToList());
    var ipGroupAssignedData = System.Text.Json.JsonSerializer.Serialize(
        Model.IpGroupOccupancies.Select(x => x.AssignedCount).ToList());

    int totalIpPersons = Model.AssignedIpCount + Model.UnassignedIpCount;
    double assignedPct = totalIpPersons > 0
        ? Math.Round((double)Model.AssignedIpCount / totalIpPersons * 100, 1) : 0;
}

<style>
/* ═══════════════════════════════════════════════════════
   DASHBOARD – PROFESSIONAL REDESIGN
   ═══════════════════════════════════════════════════════ */
.db-wrap {
    padding: 28px 24px 40px;
    background: #f7f8fc;
    min-height: 100%;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Inter', sans-serif;
}

/* ── Page Heading ── */
.db-heading { margin-bottom: 28px; }
.db-heading__title {
    font-size: 20px;
    font-weight: 800;
    color: #1a1d2e;
    margin: 0 0 4px;
    letter-spacing: -.3px;
}
.db-heading__sub {
    font-size: 13px;
    color: #8b93a7;
    margin: 0;
}
.db-heading__time {
    font-size: 12px;
    color: #b0b7c3;
    background: #fff;
    border: 1px solid #e8eaf0;
    border-radius: 8px;
    padding: 6px 14px;
}

/* ── KPI Cards ── */
.kpi-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
    margin-bottom: 24px;
}
@@media (max-width:1200px) { .kpi-grid { grid-template-columns: repeat(3,1fr); } }
@@media (max-width:768px)  { .kpi-grid { grid-template-columns: repeat(2,1fr); } }

.kpi {
    background: #fff;
    border: 1px solid #eaecf2;
    border-radius: 14px;
    padding: 20px 18px 18px;
    position: relative;
    overflow: hidden;
    transition: box-shadow .2s, transform .2s;
}
.kpi:hover {
    box-shadow: 0 8px 28px rgba(0,0,0,.09);
    transform: translateY(-2px);
}
.kpi__accent {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    border-radius: 14px 14px 0 0;
}
.kpi__icon-wrap {
    width: 42px; height: 42px;
    border-radius: 11px;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px;
    color: #fff;
    margin-bottom: 14px;
}
.kpi__value {
    font-size: 28px;
    font-weight: 900;
    color: #1a1d2e;
    line-height: 1;
    letter-spacing: -1px;
    margin-bottom: 4px;
}
.kpi__label {
    font-size: 11.5px;
    font-weight: 600;
    color: #8b93a7;
    text-transform: uppercase;
    letter-spacing: .7px;
    margin-bottom: 10px;
}
.kpi__pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 10.5px;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 20px;
    letter-spacing: .3px;
}
.pill--green  { background:#ecfdf5; color:#059669; }
.pill--blue   { background:#eff6ff; color:#2563eb; }
.pill--amber  { background:#fffbeb; color:#d97706; }
.pill--red    { background:#fef2f2; color:#dc2626; }
.pill--purple { background:#f5f3ff; color:#7c3aed; }

/* Accent colours */
.acc-indigo  { background: linear-gradient(135deg,#4f46e5,#6366f1); }
.acc-teal    { background: linear-gradient(135deg,#0d9488,#2dd4bf); }
.acc-sky     { background: linear-gradient(135deg,#0284c7,#38bdf8); }
.acc-amber   { background: linear-gradient(135deg,#b45309,#fbbf24); }
.acc-violet  { background: linear-gradient(135deg,#7c3aed,#a78bfa); }
.acc-rose    { background: linear-gradient(135deg,#be185d,#fb7185); }

.line-indigo { background:linear-gradient(90deg,#4f46e5,#818cf8); }
.line-teal   { background:linear-gradient(90deg,#0d9488,#2dd4bf); }
.line-sky    { background:linear-gradient(90deg,#0284c7,#7dd3fc); }
.line-amber  { background:linear-gradient(90deg,#b45309,#fcd34d); }
.line-violet { background:linear-gradient(90deg,#7c3aed,#c4b5fd); }
.line-rose   { background:linear-gradient(90deg,#be185d,#fda4af); }

/* ── Panel Card ── */
.panel {
    background: #fff;
    border: 1px solid #eaecf2;
    border-radius: 14px;
    overflow: hidden;
    height: 100%;
}
.panel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 22px 14px;
    border-bottom: 1px solid #f1f3f8;
}
.panel__title {
    font-size: 13.5px;
    font-weight: 700;
    color: #1a1d2e;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
}
.panel__title-icon {
    width: 28px; height: 28px;
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 12px;
    color: #fff;
}
.panel__badge {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .8px;
    color: #059669;
    background: #ecfdf5;
    padding: 3px 8px;
    border-radius: 20px;
}
.panel__link {
    font-size: 12px;
    font-weight: 600;
    color: #4f46e5;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 4px;
    transition: opacity .15s;
}
.panel__link:hover { opacity:.7; color:#4f46e5; text-decoration:none; }
.panel__body { padding: 20px 22px; }
.panel__body--flush { padding: 0; }

/* ── Progress bar ── */
.ip-meter {
    margin: 20px 0 0;
}
.ip-meter__bar-bg {
    height: 8px;
    border-radius: 99px;
    background: #f1f3f8;
    overflow: hidden;
    margin-bottom: 14px;
}
.ip-meter__bar-fill {
    height: 100%;
    border-radius: 99px;
    background: linear-gradient(90deg, #059669, #34d399);
    transition: width .8s cubic-bezier(.4,0,.2,1);
}
.ip-stat-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}
.ip-stat {
    flex: 1;
    background: #f7f8fc;
    border: 1px solid #eaecf2;
    border-radius: 10px;
    padding: 12px 14px;
    text-align: center;
}
.ip-stat__num {
    font-size: 22px;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 4px;
    letter-spacing: -0.5px;
}
.ip-stat__label {
    font-size: 10.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .6px;
    color: #8b93a7;
}

/* ── Recent Persons Table ── */
.persons-table { width: 100%; border-collapse: collapse; }
.persons-table thead th {
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .7px;
    color: #b0b7c3;
    padding: 12px 22px;
    background: #f7f8fc;
    border-bottom: 1px solid #eaecf2;
    white-space: nowrap;
}
.persons-table tbody tr {
    border-bottom: 1px solid #f1f3f8;
    transition: background .12s;
}
.persons-table tbody tr:last-child { border-bottom: none; }
.persons-table tbody tr:hover { background: #fafbff; }
.persons-table tbody td {
    padding: 13px 22px;
    font-size: 13px;
    color: #374151;
    vertical-align: middle;
}
.avatar {
    width: 36px; height: 36px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
    letter-spacing: 0;
}
.person-cell { display: flex; align-items: center; gap: 11px; }
.person-cell__name { font-weight: 600; color:#1a1d2e; font-size:13px; }
.tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 20px;
}
.tag--unit   { background:#ede9fe; color:#5b21b6; }
.tag--ip     { background:#f0fdf4; color:#166534; font-family: 'SF Mono','Fira Code',monospace; font-size:11.5px; border-radius:6px; }
.tag--none   { background:#f3f4f6; color:#9ca3af; }
.badge-assigned { background:#d1fae5; color:#065f46; display:inline-flex; align-items:center; gap:4px; font-size:11px; font-weight:700; padding:3px 9px; border-radius:20px; }
.badge-unassigned { background:#f3f4f6; color:#6b7280; font-size:11px; font-weight:600; padding:3px 9px; border-radius:20px; }

/* ── Quick Actions ── */
.qa-grid {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 14px;
    margin-top: 24px;
}
@@media (max-width:992px) { .qa-grid { grid-template-columns: repeat(2,1fr); } }
@@media (max-width:576px) { .qa-grid { grid-template-columns: repeat(1,1fr); } }

.qa-card {
    display: flex;
    align-items: center;
    gap: 14px;
    background: #fff;
    border: 1px solid #eaecf2;
    border-radius: 13px;
    padding: 16px 18px;
    text-decoration: none !important;
    transition: all .2s;
    color: inherit;
}
.qa-card:hover {
    border-color: #c7d2fe;
    box-shadow: 0 6px 22px rgba(79,70,229,.10);
    transform: translateY(-2px);
    color: inherit;
    text-decoration: none;
}
.qa-card__icon {
    width: 44px; height: 44px;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 17px;
    color: #fff;
    flex-shrink: 0;
}
.qa-card__title { font-size:13px; font-weight:700; color:#1a1d2e; display:block; }
.qa-card__sub   { font-size:11px; color:#8b93a7; }
.qa-card__arrow { margin-left:auto; color:#d1d5e0; font-size:12px; }
.qa-card:hover .qa-card__arrow { color:#4f46e5; }
/* ── Mini Calendar ── */
.mc-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; font-weight:700; font-size:14px; color:#1a1d2e; }
.mc-header button { background:none; border:none; cursor:pointer; font-size:14px; color:#8b93a7; padding:4px 8px; border-radius:6px; transition:.2s; }
.mc-header button:hover { background:#f1f3f8; color:#1a1d2e; }
.mc-weekdays { display:grid; grid-template-columns:repeat(7,1fr); text-align:center; font-size:13px; font-weight:700; color:#1a1d2e; margin-bottom:12px; }
.mc-days { display:grid; grid-template-columns:repeat(7,1fr); gap:6px; }
.mc-day { display:flex; align-items:center; justify-content:center; height:34px; font-size:13px; font-weight:600; color:#1a1d2e; border-radius:8px; cursor:pointer; transition:background .2s, color .2s; }
.mc-day:hover:not(.mc-active) { background:#f1f3f8; }
.mc-day.mc-other-month { color:#e2e5eb; font-weight:500; }
.mc-day.mc-active { background:#4f348b; color:#fff; }


/* ── Animations ── */
@@keyframes fadeUp {
    from { opacity:0; transform:translateY(14px); }
    to   { opacity:1; transform:translateY(0); }
}
.anim { animation: fadeUp .35s ease both; }
.a1  { animation-delay:.04s; }
.a2  { animation-delay:.08s; }
.a3  { animation-delay:.12s; }
.a4  { animation-delay:.16s; }
.a5  { animation-delay:.20s; }
.a6  { animation-delay:.24s; }
.a7  { animation-delay:.28s; }
.a8  { animation-delay:.32s; }
</style>

<div class="db-wrap">

  <!-- ── Page Heading ──────────────────────────────────────── -->
  <div class="db-heading d-flex align-items-start justify-content-between anim a1">
    <div>
      <h1 class="db-heading__title">
        Kontrol Paneli
      </h1>
      <p class="db-heading__sub">Ağ ve personel yönetimine genel bakış · canlı veriler</p>
    </div>
    <div class="db-heading__time d-none d-md-block">
      <i class="far fa-clock mr-1"></i>
      @DateTime.Now.ToString("dd MMMM yyyy · HH:mm", new System.Globalization.CultureInfo("tr-TR"))
    </div>
  </div>

  <!-- ── KPI Grid ──────────────────────────────────────────── -->
  <div class="kpi-grid">

    <div class="kpi anim a1">
      <div class="kpi__accent line-indigo"></div>
      <div class="kpi__icon-wrap acc-indigo"><i class="fas fa-users"></i></div>
      <div class="kpi__label">Toplam Personel</div>
      <div class="kpi__value">@Model.TotalPersonCount</div>
      <span class="kpi__pill pill--green"><i class="fas fa-check-circle"></i> Aktif</span>
    </div>

    <div class="kpi anim a2">
      <div class="kpi__accent line-teal"></div>
      <div class="kpi__icon-wrap acc-teal"><i class="fas fa-building"></i></div>
      <div class="kpi__label">Toplam Bina</div>
      <div class="kpi__value">@Model.TotalBinaCount</div>
      <span class="kpi__pill pill--green"><i class="fas fa-check-circle"></i> Aktif</span>
    </div>

    <div class="kpi anim a3">
      <div class="kpi__accent line-sky"></div>
      <div class="kpi__icon-wrap acc-sky"><i class="fas fa-sitemap"></i></div>
      <div class="kpi__label">Toplam Birim</div>
      <div class="kpi__value">@Model.TotalBirimCount</div>
      <span class="kpi__pill pill--blue"><i class="fas fa-layer-group"></i> Aktif</span>
    </div>

    <div class="kpi anim a4">
      <div class="kpi__accent line-amber"></div>
      <div class="kpi__icon-wrap acc-amber"><i class="fas fa-server"></i></div>
      <div class="kpi__label">IP Grubu</div>
      <div class="kpi__value">@Model.TotalIpCount</div>
      <span class="kpi__pill pill--amber"><i class="fas fa-network-wired"></i> Toplam</span>
    </div>

    <div class="kpi anim a5">
      <div class="kpi__accent line-violet"></div>
      <div class="kpi__icon-wrap acc-violet"><i class="fas fa-link"></i></div>
      <div class="kpi__label">IP Atanmış</div>
      <div class="kpi__value">@Model.AssignedIpCount</div>
      <span class="kpi__pill pill--purple"><i class="fas fa-bolt"></i> Kullanımda</span>
    </div>

    <div class="kpi anim a6">
      <div class="kpi__accent line-rose"></div>
      <div class="kpi__icon-wrap acc-rose"><i class="fas fa-unlink"></i></div>
      <div class="kpi__label">IP'siz Personel</div>
      <div class="kpi__value">@Model.UnassignedIpCount</div>
      <span class="kpi__pill pill--red"><i class="fas fa-exclamation-circle"></i> Atanmamış</span>
    </div>

  </div><!-- /kpi-grid -->

  <!-- ── Charts Row ─────────────────────────────────────────── -->
  <div class="row anim a4" style="margin-bottom:24px;">

    <!-- IP Group Occupancy Chart -->
    <div class="col-lg-7 col-md-12 mb-4 mb-lg-0">
      <div class="panel">
        <div class="panel__head">
          <h6 class="panel__title">
            <span class="panel__title-icon acc-amber"><i class="fas fa-network-wired" style="font-size:11px;"></i></span>
            IP Grupları Doluluk Oranları
          </h6>
          <span class="panel__badge">● Canlı</span>
        </div>
        <div class="panel__body">
          @if (!Model.IpGroupOccupancies.Any())
          {
            <div class="text-center py-4" style="color:#b0b7c3;">
              <i class="fas fa-network-wired" style="font-size:28px;display:block;margin-bottom:8px;"></i>
              Henüz IP Grubu verisi yok.
            </div>
          }
          else
          {
            <div style="position: relative; height: 220px;">
                <canvas id="ipGroupChart"></canvas>
            </div>
          }
        </div>
      </div>
    </div>

    <!-- IP Status Panel -->
    <div class="col-lg-5 col-md-12">
      <div class="panel">
        <div class="panel__head">
          <h6 class="panel__title">
            <span class="panel__title-icon acc-teal"><i class="fas fa-chart-pie" style="font-size:11px;"></i></span>
            IP Atama Oranı
          </h6>
          <span class="panel__badge">● Canlı</span>
        </div>
        <div class="panel__body">

          <!-- Donut -->
          <div class="d-flex align-items-center justify-content-center mb-3">
            <div style="position:relative;width:170px;height:170px;">
              <canvas id="donutChart" width="170" height="170"></canvas>
              <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;">
                <div style="font-size:26px;font-weight:900;color:#1a1d2e;line-height:1;">@assignedPct<span style="font-size:14px;font-weight:600;">%</span></div>
                <div style="font-size:10px;font-weight:600;color:#8b93a7;text-transform:uppercase;letter-spacing:.5px;margin-top:2px;">Atanmış</div>
              </div>
            </div>
          </div>

          <!-- Progress Bar -->
          <div class="ip-meter">
            <div style="display:flex;justify-content:space-between;margin-bottom:6px;">
              <span style="font-size:11px;font-weight:600;color:#8b93a7;">IP Atama Durumu</span>
              <span style="font-size:11px;font-weight:700;color:#059669;">@Model.AssignedIpCount / @totalIpPersons</span>
            </div>
            <div class="ip-meter__bar-bg">
              <div class="ip-meter__bar-fill" style="width:@(assignedPct)%;"></div>
            </div>
          </div>

          <!-- Stats -->
          <div class="ip-stat-row mt-3">
            <div class="ip-stat">
              <div class="ip-stat__num" style="color:#059669;">@Model.AssignedIpCount</div>
              <div class="ip-stat__label">IP Atanmış</div>
            </div>
            <div class="ip-stat">
              <div class="ip-stat__num" style="color:#dc2626;">@Model.UnassignedIpCount</div>
              <div class="ip-stat__label">IP Atanmamış</div>
            </div>
            <div class="ip-stat">
              <div class="ip-stat__num" style="color:#4f46e5;">@totalIpPersons</div>
              <div class="ip-stat__label">Toplam</div>
            </div>
          </div>

        </div>
      </div>
    </div>

  </div><!-- /charts row -->

  <!-- ── Aylık Kişi Dağılım Grafiği ve Takvim ────────────────────────────────── -->
  <div class="row anim a5" style="margin-bottom:24px;">
    
    <!-- Line Chart Panel -->
    <div class="col-lg-8 col-md-12 mb-4 mb-lg-0">
      <div style="background:#fff;border:1px solid #eaecf2;border-radius:14px;overflow:hidden;height:100%;display:flex;flex-direction:column;">
        
        <!-- Panel Header -->
        <div style="display:flex;align-items:center;justify-content:space-between;padding:18px 24px 16px;border-bottom:1px solid #f1f3f8;">
          <div style="display:flex;align-items:center;gap:10px;">
            <div style="width:32px;height:32px;border-radius:10px;background:linear-gradient(135deg,#7c3aed,#a855f7);display:flex;align-items:center;justify-content:center;">
              <i class="fas fa-chart-line" style="color:#fff;font-size:13px;"></i>
            </div>
            <div>
              <div style="font-size:13.5px;font-weight:700;color:#1a1d2e;line-height:1.2;">Aylara Göre Kayıt Trendi</div>
              <div style="font-size:11px;color:#8b93a7;margin-top:1px;">@DateTime.Now.Year yılı · Ocak – @DateTime.Now.ToString("MMMM", new System.Globalization.CultureInfo("tr-TR"))</div>
            </div>
          </div>
          <div style="display:flex;align-items:center;gap:20px;">
            <!-- Mini Stats -->
            <div style="text-align:right;">
              <div style="font-size:11px;color:#8b93a7;font-weight:600;text-transform:uppercase;letter-spacing:.5px;">Bu Yıl Toplam</div>
              <div style="font-size:20px;font-weight:900;color:#7c3aed;line-height:1.1;">@Model.PersonelByMonth.Sum(x => x.PersonelSayisi)</div>
            </div>
            <div style="width:1px;height:36px;background:#eaecf2;"></div>
            @{
                var peakMonth = Model.PersonelByMonth.OrderByDescending(x => x.PersonelSayisi).FirstOrDefault();
            }
            <div style="text-align:right;">
              <div style="font-size:11px;color:#8b93a7;font-weight:600;text-transform:uppercase;letter-spacing:.5px;">En Yoğun Ay</div>
              <div style="font-size:16px;font-weight:800;color:#1a1d2e;line-height:1.1;">
                @(peakMonth != null ? $"{peakMonth.Ay} ({peakMonth.PersonelSayisi})" : "—")
              </div>
            </div>
            <span class="d-none d-xl-inline-block" style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:#059669;background:#ecfdf5;padding:4px 10px;border-radius:20px;">● Canlı</span>
          </div>
        </div>

        <!-- Chart Body -->
        <div style="padding:24px 24px 20px;flex:1;display:flex;flex-direction:column;justify-content:center;">
          @if (!Model.PersonelByMonth.Any() || Model.PersonelByMonth.All(x => x.PersonelSayisi == 0))
          {
            <div style="text-align:center;padding:40px 0;color:#b0b7c3;">
              <i class="fas fa-chart-line" style="font-size:32px;display:block;margin-bottom:10px;"></i>
              <span style="font-size:13px;">Henüz kayıt verisi yok.</span>
            </div>
          }
          else
          {
            <canvas id="lineChart" height="90" style="max-height:220px;"></canvas>
          }
        </div>
      </div>
    </div>

    <!-- Calendar Panel -->
    <div class="col-lg-4 col-md-12">
      <div style="background:#fff;border:1px solid #eaecf2;border-radius:14px;overflow:hidden;height:100%;padding:22px;">
        <div style="font-size:15px;font-weight:700;color:#1a1d2e;margin-bottom:20px;display:flex;align-items:center;gap:8px;">
          <i class="fas fa-calendar-alt"></i> Calendar
        </div>
        <div id="miniCalendar" class="mini-calendar"></div>
      </div>
    </div>

  </div>

  <!-- ── Birime Göre Personel Dağılımı ────────────────────────────── -->
  <div class="row anim a5" style="margin-bottom:24px;">
    <div class="col-12">
      <div class="panel">
        <div class="panel__head">
          <h6 class="panel__title">
            <span class="panel__title-icon acc-indigo"><i class="fas fa-chart-bar" style="font-size:11px;"></i></span>
            Birime Göre Personel Dağılımı
          </h6>
          <span class="panel__badge">● Canlı</span>
        </div>
        <div class="panel__body">
          @if (!Model.PersonelByBirim.Any())
          {
            <div class="text-center py-4" style="color:#b0b7c3;">
              <i class="fas fa-chart-bar" style="font-size:28px;display:block;margin-bottom:8px;"></i>
              Henüz birim verisi yok.
            </div>
          }
          else
          {
            <div style="position: relative; height: 260px;">
              <canvas id="barChart"></canvas>
            </div>
          }
        </div>
      </div>
    </div>
  </div>

  <!-- ── Recent Persons Table ───────────────────────────────── -->
  <div class="panel anim a6" style="margin-bottom:24px;">
    <div class="panel__head">
      <h6 class="panel__title">
        <span class="panel__title-icon acc-violet"><i class="fas fa-user-clock" style="font-size:10px;"></i></span>
        Son Eklenen Personeller
      </h6>
      <a asp-controller="Person" asp-action="Index" class="panel__link">
        Tümünü Gör <i class="fas fa-arrow-right"></i>
      </a>
    </div>
    <div class="panel__body--flush">
      @if (!Model.RecentPersons.Any())
      {
        <div class="text-center py-5" style="color:#b0b7c3;">
          <i class="fas fa-user-slash" style="font-size:30px;display:block;margin-bottom:10px;"></i>
          Henüz personel eklenmemiş.
        </div>
      }
      else
      {
        <div class="table-responsive">
          <table class="persons-table">
            <thead>
              <tr>
                <th>Personel</th>
                <th>Birim</th>
                <th>Bina</th>
                <th>IP Adresi</th>
                <th>Durum</th>
              </tr>
            </thead>
            <tbody>
              @{
                var palette = new[]{"#4f46e5","#0d9488","#0284c7","#7c3aed","#be185d","#b45309","#059669"};
                int ri = 0;
              }
              @foreach (var p in Model.RecentPersons)
              {
                var clr = palette[ri % palette.Length];
                var parts = p.AdSoyad.Trim().Split(' ');
                var initials = parts.Length >= 2
                    ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
                    : p.AdSoyad.Length > 0 ? p.AdSoyad[0].ToString().ToUpper() : "?";
                ri++;
                <tr>
                  <td>
                    <div class="person-cell">
                      <div class="avatar" style="background:@clr;">@initials</div>
                      <span class="person-cell__name">@p.AdSoyad</span>
                    </div>
                  </td>
                  <td>
                    @if (p.BirimAdi != "—")
                    {
                      <span class="tag tag--unit">@p.BirimAdi</span>
                    }
                    else
                    {
                      <span class="tag tag--none">—</span>
                    }
                  </td>
                  <td style="font-size:13px;color:#374151;">@p.BinaAdi</td>
                  <td>
                    @if (p.HasIp)
                    {
                      <span class="tag tag--ip">@p.IpAdresi</span>
                    }
                    else
                    {
                      <span class="tag tag--none">—</span>
                    }
                  </td>
                  <td>
                    @if (p.HasIp)
                    {
                      <span class="badge-assigned"><i class="fas fa-check-circle"></i> Atanmış</span>
                    }
                    else
                    {
                      <span class="badge-unassigned">IP Yok</span>
                    }
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
    </div>
  </div>

  <!-- ── Quick Actions ─────────────────────────────────────── -->
  <div class="anim a7">
    <p style="font-size:10.5px;font-weight:700;color:#b0b7c3;text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;">
      Modüller
    </p>
    <div class="qa-grid">

      <a asp-controller="Person" asp-action="Index" class="qa-card">
        <div class="qa-card__icon acc-indigo"><i class="fas fa-users"></i></div>
        <div>
          <span class="qa-card__title">Personel Yönetimi</span>
          <span class="qa-card__sub">@Model.TotalPersonCount kayıt</span>
        </div>
        <i class="fas fa-chevron-right qa-card__arrow"></i>
      </a>

      <a asp-controller="Bina" asp-action="Index" class="qa-card">
        <div class="qa-card__icon acc-teal"><i class="fas fa-building"></i></div>
        <div>
          <span class="qa-card__title">Bina Yönetimi</span>
          <span class="qa-card__sub">@Model.TotalBinaCount bina</span>
        </div>
        <i class="fas fa-chevron-right qa-card__arrow"></i>
      </a>

      <a asp-controller="Birim" asp-action="Index" class="qa-card">
        <div class="qa-card__icon acc-sky"><i class="fas fa-sitemap"></i></div>
        <div>
          <span class="qa-card__title">Birim Yönetimi</span>
          <span class="qa-card__sub">@Model.TotalBirimCount birim</span>
        </div>
        <i class="fas fa-chevron-right qa-card__arrow"></i>
      </a>

      <a asp-controller="Ip" asp-action="Index" class="qa-card">
        <div class="qa-card__icon acc-amber"><i class="fas fa-server"></i></div>
        <div>
          <span class="qa-card__title">IP Yönetimi</span>
          <span class="qa-card__sub">@Model.TotalIpCount IP grubu</span>
        </div>
        <i class="fas fa-chevron-right qa-card__arrow"></i>
      </a>

    </div>
  </div>

</div><!-- /db-wrap -->

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
    Chart.defaults.font.family = "-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif";

    /* ── Color palette ── */
    const COLORS = [
        '#4f46e5','#0d9488','#0284c7','#b45309',
        '#7c3aed','#be185d','#059669','#d97706'
    ];
    const alpha = (hex, a) => {
        const r = parseInt(hex.slice(1,3),16);
        const g = parseInt(hex.slice(3,5),16);
        const b = parseInt(hex.slice(5,7),16);
        return `rgba(${r},${g},${b},${a})`;
    };

    /* ── Bar Chart ── */
    const barEl = document.getElementById('barChart');
    if (barEl) {
        const labels = @Html.Raw(birimLabels);
        const data   = @Html.Raw(birimData);
        new Chart(barEl, {
            type: 'bar',
            data: {
                labels,
                datasets: [{
                    label: 'Personel',
                    data,
                    backgroundColor: labels.map((_,i) => alpha(COLORS[i % COLORS.length], .85)),
                    borderColor:     labels.map((_,i) => COLORS[i % COLORS.length]),
                    borderWidth: 1.5,
                    borderRadius: 8,
                    borderSkipped: false,
                    hoverBackgroundColor: labels.map((_,i) => COLORS[i % COLORS.length]),
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1a1d2e',
                        titleFont: { size:12, weight:'700' },
                        bodyFont: { size:12 },
                        padding: 10,
                        cornerRadius: 8,
                        callbacks: {
                            label: c => `  ${c.parsed.y} personel`
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        border: { display: false },
                        ticks: {
                            font: { size:12, weight:'600' },
                            color: '#8b93a7',
                            maxRotation: 30
                        }
                    },
                    y: {
                        beginAtZero: true,
                        grid: { color:'#f1f3f8', lineWidth:1 },
                        border: { display: false, dash:[4,4] },
                        ticks: {
                            stepSize: 1,
                            precision: 0,
                            font: { size:11 },
                            color: '#b0b7c3',
                            padding: 8
                        }
                    }
                },
                animation: {
                    duration: 700,
                    easing: 'easeOutQuart'
                }
            }
        });
    }

    /* ── Donut Chart ── */
    const donutEl = document.getElementById('donutChart');
    if (donutEl) {
        const assigned   = @Model.AssignedIpCount;
        const unassigned = @Model.UnassignedIpCount;
        const total = assigned + unassigned;

        new Chart(donutEl, {
            type: 'doughnut',
            data: {
                labels: ['IP Atanmış', 'Atanmamış'],
                datasets: [{
                    data: total === 0 ? [1, 0] : [assigned, unassigned],
                    backgroundColor: total === 0
                        ? ['#f1f3f8', '#f1f3f8']
                        : ['#059669', '#f87171'],
                    borderColor: total === 0
                        ? ['#e5e7eb']
                        : ['#047857', '#ef4444'],
                    borderWidth: 2,
                    hoverOffset: 5
                }]
            },
            options: {
                responsive: false,
                cutout: '72%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1a1d2e',
                        padding: 10,
                        cornerRadius: 8,
                        titleFont: { size:12, weight:'700' },
                        bodyFont:  { size:12 },
                        callbacks: {
                            label: c => {
                                if (total === 0) return ' Veri yok';
                                const pct = ((c.parsed / total)*100).toFixed(1);
                                return `  ${c.label}: ${c.parsed} (${pct}%)`;
                            }
                        }
                    }
                },
                animation: { duration: 900, easing: 'easeOutQuart' }
            }
        });
    }

    /* ── Line Chart – Aylara Göre Kayıt Trendi ── */
    const lineEl = document.getElementById('lineChart');
    if (lineEl) {
        const mLabels = @Html.Raw(monthLabels);
        const mData   = @Html.Raw(monthData);
        const maxVal  = Math.max(...mData, 1);

        const lineCtx = lineEl.getContext('2d');

        // Rich gradient fill (Amblem Purple)
        const grad = lineCtx.createLinearGradient(0, 0, 0, lineEl.offsetHeight || 280);
        grad.addColorStop(0,   'rgba(124,58,237,.35)');
        grad.addColorStop(0.45,'rgba(124,58,237,.12)');
        grad.addColorStop(1,   'rgba(124,58,237,0)');

        // Crosshair + annotation plugin (lightweight, inline)
        const crosshairPlugin = {
            id: 'crosshair',
            afterDraw(chart) {
                if (!chart._active || !chart._active.length) return;
                const ctx2 = chart.ctx;
                const x = chart._active[0].element.x;
                const yAxis = chart.scales.y;
                ctx2.save();
                ctx2.beginPath();
                ctx2.moveTo(x, yAxis.top);
                ctx2.lineTo(x, yAxis.bottom);
                ctx2.lineWidth = 1.5;
                ctx2.strokeStyle = 'rgba(124,58,237,.35)';
                ctx2.setLineDash([4, 4]);
                ctx2.stroke();
                ctx2.restore();
            }
        };

        new Chart(lineEl, {
            type: 'line',
            plugins: [crosshairPlugin],
            data: {
                labels: mLabels,
                datasets: [{
                    label: 'Kayıt',
                    data: mData,
                    fill: true,
                    backgroundColor: grad,
                    borderColor: '#7c3aed',
                    borderWidth: 2.5,
                    pointBackgroundColor: mData.map((v, i) => i === mData.length - 1 ? '#7c3aed' : '#fff'),
                    pointBorderColor: '#7c3aed',
                    pointBorderWidth: 2,
                    pointRadius: mData.map((v, i) => i === mData.length - 1 ? 6 : 4),
                    pointHoverRadius: 8,
                    pointHoverBackgroundColor: '#7c3aed',
                    pointHoverBorderColor: '#fff',
                    pointHoverBorderWidth: 2.5,
                    tension: 0.42
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        enabled: true,
                        backgroundColor: '#1a1d2e',
                        titleColor: '#fff',
                        bodyColor: 'rgba(255,255,255,.75)',
                        borderColor: 'rgba(255,255,255,.08)',
                        borderWidth: 1,
                        titleFont: { size:12, weight:'700', family:"'Segoe UI',sans-serif" },
                        bodyFont:  { size:12, family:"'Segoe UI',sans-serif" },
                        padding: { x:14, y:10 },
                        cornerRadius: 10,
                        displayColors: false,
                        callbacks: {
                            title: items => items[0].label + ' ' + @DateTime.Now.Year,
                            label: c => {
                                const v = c.parsed.y;
                                const pct = maxVal > 0 ? ((v/maxVal)*100).toFixed(0) : 0;
                                return `  ${v} kişi  (zirvenin %${pct}u)`;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        border: { display: false },
                        ticks: {
                            font: { size:12, weight:'600', family:"'Segoe UI',sans-serif" },
                            color: '#8b93a7',
                            padding: 8
                        }
                    },
                    y: {
                        beginAtZero: true,
                        suggestedMax: maxVal + Math.ceil(maxVal * .15) + 1,
                        grid: {
                            color: ctx => ctx.tick.value === 0 ? '#e5e7eb' : '#f1f3f8',
                            lineWidth: ctx => ctx.tick.value === 0 ? 1.5 : 1
                        },
                        border: { display: false, dash:[4,4] },
                        ticks: {
                            stepSize: Math.max(1, Math.ceil(maxVal / 6)),
                            precision: 0,
                            font: { size:11, family:"'Segoe UI',sans-serif" },
                            color: '#b0b7c3',
                            padding: 10
                        }
                    }
                },
                animation: {
                    duration: 1000,
                    easing: 'easeOutQuart',
                    onComplete() {
                        // Glow effect on last point
                        const chart = this;
                        const meta = chart.getDatasetMeta(0);
                        if (!meta.data.length) return;
                        const last = meta.data[meta.data.length - 1];
                        const ctx2 = chart.ctx;
                        ctx2.save();
                        ctx2.beginPath();
                        ctx2.arc(last.x, last.y, 12, 0, Math.PI * 2);
                        ctx2.fillStyle = 'rgba(124,58,237,.18)';
                        ctx2.fill();
                        ctx2.restore();
                    }
                }
            }
        });
    }

    /* ── IP Group Occupancy Chart ── */
    const ipGroupEl = document.getElementById('ipGroupChart');
    if (ipGroupEl) {
        const ipLabels = @Html.Raw(ipGroupLabels);
        const totalData = @Html.Raw(ipGroupTotalData);
        const assignedData = @Html.Raw(ipGroupAssignedData);

        new Chart(ipGroupEl, {
            type: 'bar',
            data: {
                labels: ipLabels,
                datasets: [
                    {
                        label: 'Kullanılan IP',
                        data: assignedData,
                        backgroundColor: '#059669', // Green for used
                        borderRadius: 4,
                        maxBarThickness: 24,
                    },
                    {
                        label: 'Boş IP',
                        data: totalData.map((t, i) => t - assignedData[i]),
                        backgroundColor: '#e5e7eb', // Gray for empty
                        borderRadius: 4,
                        maxBarThickness: 24,
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: { font: { family:"'Segoe UI',sans-serif", size: 12, weight: '600' } }
                    },
                    tooltip: {
                        backgroundColor: '#1a1d2e',
                        titleFont: { size:12, weight:'700' },
                        bodyFont: { size:12 },
                        padding: 10,
                        cornerRadius: 8,
                        mode: 'index',
                        intersect: false,
                    }
                },
                scales: {
                    x: {
                        stacked: true,
                        grid: { display: false },
                        border: { display: false },
                        ticks: {
                            font: { size:11, weight:'600' },
                            color: '#8b93a7',
                            maxRotation: 45,
                            minRotation: 0
                        }
                    },
                    y: {
                        stacked: true,
                        beginAtZero: true,
                        grid: { color:'#f1f3f8', lineWidth:1 },
                        border: { display: false, dash:[4,4] },
                        ticks: {
                            precision: 0,
                            font: { size:11 },
                            color: '#b0b7c3',
                            padding: 8
                        }
                    }
                },
                animation: {
                    duration: 800,
                    easing: 'easeOutQuart'
                }
            }
        });
    }

    /* ── Progress bar animate on load ── */
    const fill = document.querySelector('.ip-meter__bar-fill');
    if (fill) {
        const target = fill.style.width;
        fill.style.width = '0%';
        requestAnimationFrame(() => {
            setTimeout(() => { fill.style.width = target; }, 100);
        });
    }

    /* ── Mini Calendar Logic ── */
    function renderMiniCalendar() {
        const calContainer = document.getElementById('miniCalendar');
        if (!calContainer) return;

        const date = new Date(2026, 6, 23); // July 23, 2026 as shown in the image
        const year = date.getFullYear();
        const month = date.getMonth(); // 0-indexed (6 = July)
        const todayDate = date.getDate(); // 23

        const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
        
        let html = `
            <div class="mc-header">
                <button type="button">&laquo;</button>
                <span>${monthNames[month]} ${year}</span>
                <button type="button">&raquo;</button>
            </div>
            <div class="mc-weekdays">
                <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
            </div>
            <div class="mc-days">
        `;

        // July 2026 calendar logic
        // July 1, 2026 is a Wednesday (3)
        // Days in June 2026: 30
        // Days in July 2026: 31
        const firstDayIndex = 3; 
        const daysInPrevMonth = 30;
        const daysInMonth = 31;

        // Previous month's days
        for (let i = firstDayIndex - 1; i >= 0; i--) {
            html += `<div class="mc-day mc-other-month">${daysInPrevMonth - i}</div>`;
        }

        // Current month's days
        for (let i = 1; i <= daysInMonth; i++) {
            if (i === todayDate) {
                html += `<div class="mc-day mc-active">${i}</div>`;
            } else {
                html += `<div class="mc-day">${i}</div>`;
            }
        }

        // Next month's days to complete the grid (42 cells total)
        const totalCells = firstDayIndex + daysInMonth;
        const nextDays = 42 - totalCells;
        for (let i = 1; i <= nextDays; i++) {
            html += `<div class="mc-day mc-other-month">${i}</div>`;
        }

        html += `</div>`;
        calContainer.innerHTML = html;
    }

    renderMiniCalendar();

})();
</script>
}
