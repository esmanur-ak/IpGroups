@model IpGroups.Models.Entities.AppUser
@{
    ViewData["Title"] = "Profilim";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var isFemale = Model?.Gender == "Kadın";
    var avatarUrl = !string.IsNullOrEmpty(Model?.ProfilePictureUrl)
        ? Model.ProfilePictureUrl
        : (isFemale ? "/images/female-avatar.png" : "/images/male-avatar.png");
}

<div class="row">
    <div class="col-md-4 grid-margin stretch-card">
        <div class="card">
            <div class="card-body text-center">
                <h4 class="card-title">Profil Resmi</h4>
                <div class="mb-3">
                    <img src="@avatarUrl" alt="profile" class="img-lg rounded-circle mb-3" style="width: 150px; height: 150px; object-fit: cover;" />
                </div>
                <h4>@Model.AdSoyad</h4>
                <p class="text-muted">@Model.Email</p>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["SuccessMessage"]
                    </div>
                }

                <form asp-controller="Account" asp-action="UpdateProfile" method="post" enctype="multipart/form-data">
                    <div class="form-group">
                        <label>Yeni Profil Resmi Seç</label>
                        <input type="file" name="profilePicture" class="form-control file-upload-info" accept="image/*" />
                    </div>
                    <button type="submit" class="btn btn-primary mr-2">Güncelle</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-8 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Profil Bilgileri</h4>
                <form class="forms-sample">
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">Ad Soyad</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control" value="@Model.AdSoyad" readonly />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">E-Posta</label>
                        <div class="col-sm-9">
                            <input type="email" class="form-control" value="@Model.Email" readonly />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">Cinsiyet</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control" value="@Model.Gender" readonly />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">Kayıt Tarihi</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control" value="@Model.CreatedDate.ToString("dd.MM.yyyy")" readonly />
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
