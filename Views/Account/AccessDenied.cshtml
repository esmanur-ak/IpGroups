@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Erişim Engellendi";
}

<div class="row w-100 mx-0">
    <div class="col-lg-5 col-md-7 col-sm-9 mx-auto text-center">
        <div class="auth-form-light py-5 px-4 px-sm-5 shadow-lg rounded">
            <div class="mb-4">
                <i class="fas fa-exclamation-triangle text-danger display-3"></i>
            </div>
            <h2 class="font-weight-bold text-dark mb-2">Erişim Engellendi</h2>
            <p class="text-muted mb-4">Bu sayfaya veya kaynağa erişmek için gerekli yetkiye sahip değilsiniz.</p>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg font-weight-medium px-4">
                    <i class="fas fa-home mr-2"></i> Ana Sayfaya Dön
                </a>
            </div>
        </div>
    </div>
</div>
