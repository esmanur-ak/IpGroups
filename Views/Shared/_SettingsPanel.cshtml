<div class="theme-setting-wrapper">
  <div id="settings-trigger" title="Tema Renk Ayarları"><i class="fas fa-palette"></i></div>
  <div id="theme-settings" class="settings-panel">
    <i class="settings-close fa fa-times"></i>
    
    <p class="settings-heading">SOL MENÜ RENKLERİ (SIDEBAR SKINS)</p>
    <div class="color-tiles sidebar-color-tiles mx-0 px-4 mb-3">
      <div class="tiles purple selected" data-sidebar="sidebar-purple" title="Amblem Mor (Varsayılan)"></div>
      <div class="tiles primary" data-sidebar="sidebar-primary" title="İndigo Mor"></div>
      <div class="tiles success" data-sidebar="sidebar-success" title="Zümrüt Yeşil"></div>
      <div class="tiles warning" data-sidebar="sidebar-warning" title="Kehribar Turuncu"></div>
      <div class="tiles danger" data-sidebar="sidebar-danger" title="Gül Kırmızı"></div>
      <div class="tiles info" data-sidebar="sidebar-info" title="Gökyüzü Mavi"></div>
      <div class="tiles dark" data-sidebar="sidebar-dark" title="Gece Koyu"></div>
      <div class="tiles light" data-sidebar="sidebar-light" title="Açık Tema"></div>
    </div>

    <p class="settings-heading">ÜST BAŞLIK RENKLERİ (HEADER SKINS)</p>
    <div class="color-tiles header-color-tiles mx-0 px-4">
      <div class="tiles purple selected" data-header="navbar-purple" title="Amblem Mor (Varsayılan)"></div>
      <div class="tiles primary" data-header="navbar-primary" title="İndigo"></div>
      <div class="tiles success" data-header="navbar-success" title="Zümrüt Yeşil"></div>
      <div class="tiles warning" data-header="navbar-warning" title="Kehribar Turuncu"></div>
      <div class="tiles danger" data-header="navbar-danger" title="Gül Kırmızı"></div>
      <div class="tiles info" data-header="navbar-info" title="Gökyüzü Mavi"></div>
      <div class="tiles dark" data-header="navbar-dark" title="Gece Koyu"></div>
      <div class="tiles light" data-header="navbar-light" title="Açık Tema"></div>
    </div>
  </div>
</div>
