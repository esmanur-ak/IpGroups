@model IpGroups.Models.ViewModels.LoginViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Giriş Yap";
}

<style>
    /* Reset layout wrapper */
    html, body,
    .container-scroller,
    .container-fluid.page-body-wrapper.full-page-wrapper,
    .content-wrapper.auth {
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        height: 100% !important;
        min-height: 100vh !important;
        background: #f4f5fa !important;
    }

    /* Full screen login container */
    .login-container {
        display: flex;
        width: 100vw;
        min-height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 9999;
        background: #f4f5fa;
    }

    /* Sol Panel - Bina Görseli */
    .login-bg-side {
        flex: 1;
        position: relative;
        background-image: url('@Url.Content("~/images/bina.jpg")');
        background-size: cover;
        background-position: center center;
        background-repeat: no-repeat;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 3rem;
    }

    .login-bg-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(15, 23, 42, 0.75) 0%, rgba(30, 41, 59, 0.45) 60%, rgba(0, 0, 0, 0.3) 100%);
        z-index: 1;
    }

    .login-bg-content {
        position: relative;
        z-index: 2;
        color: #ffffff;
    }

    .login-bg-content h2 {
        font-size: 2.2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    }

    .login-bg-content p {
        font-size: 1.1rem;
        opacity: 0.9;
        margin: 0;
        text-shadow: 0 2px 8px rgba(0,0,0,0.5);
    }

    /* Sağ Panel - Form */
    .login-form-side {
        width: 480px;
        max-width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        padding: 2.5rem 2rem;
        box-shadow: -5px 0 25px rgba(0,0,0,0.05);
    }

    .login-form-box {
        width: 100%;
        max-width: 360px;
    }

    .login-logo {
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .login-logo img {
        height: 55px;
        width: auto;
    }

    .login-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1e293b;
        text-align: center;
        margin-bottom: 0.25rem;
    }

    .login-subtitle {
        font-size: 0.9rem;
        color: #64748b;
        text-align: center;
        margin-bottom: 2rem;
    }

    .login-form-box .form-control {
        height: 48px;
        border-radius: 8px;
        font-size: 0.95rem;
    }

    .login-form-box .input-group-text {
        border-radius: 8px 0 0 8px;
        background-color: #f8fafc;
        border-right: none;
    }

    .login-form-box .form-control {
        border-left: none;
    }

    .login-btn {
        height: 48px;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        background: #6366f1;
        border: none;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.35);
        transition: all 0.2s ease;
    }

    .login-btn:hover {
        background: #4f46e5;
        box-shadow: 0 6px 16px rgba(99, 102, 241, 0.45);
        transform: translateY(-1px);
    }

    /* Mobil uyumluluk */
    @@media (max-width: 768px) {
        .login-container {
            flex-direction: column;
        }
        .login-bg-side {
            min-height: 220px;
            flex: initial;
            padding: 1.5rem;
        }
        .login-bg-content h2 {
            font-size: 1.4rem;
        }
        .login-form-side {
            width: 100%;
            flex: 1;
        }
    }
</style>

<div class="login-container">
    <!-- Sol Taraf: Bina Resmi ve Başlık -->
    <div class="login-bg-side">
        <div class="login-bg-overlay"></div>
        <div class="login-bg-content">
            <h2>IP Grup Yönetim Sistemi</h2>
            <p>Ağ ve kişi yönetim platformuna hoş geldiniz.</p>
        </div>
    </div>

    <!-- Sağ Taraf: Giriş Formu -->
    <div class="login-form-side">
        <div class="login-form-box">
            <div class="login-logo">
                <img src="~/images/logo.svg" alt="IpGroups Logo" />
            </div>
            <h1 class="login-title">Hoş Geldiniz</h1>
            <p class="login-subtitle">Devam etmek için hesabınıza giriş yapın</p>

            <form asp-action="Login" method="post" asp-route-returnurl="@ViewData["ReturnUrl"]">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Email" class="form-label font-weight-medium small text-secondary">E-Posta Adresi</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fa fa-envelope text-primary"></i>
                        </span>
                        <input asp-for="Email" class="form-control" placeholder="ornek@ipgroups.com" autocomplete="username" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Password" class="form-label font-weight-medium small text-secondary">Şifre</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fa fa-lock text-primary"></i>
                        </span>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
                        <label class="form-check-label small text-muted" for="rememberMeCheck">
                            Beni Hatırla
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-block login-btn w-100">
                    <i class="fas fa-sign-in-alt me-2"></i> Giriş Yap
                </button>
            </form>
        </div>
    </div>
</div>
