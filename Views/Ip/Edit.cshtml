@model IpGroups.Models.ViewModels.IpViewModel

@{
    ViewData["Title"] = "IP Düzenle";
}

<div class="row">
    <div class="col-md-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">IP Bilgilerini Güncelle</h4>
                <form class="forms-sample" asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="form-group">
                        <label asp-for="IpNo">IP No</label>
                        <input type="text" asp-for="IpNo" class="form-control" placeholder="Örn: 192.168.1.100" required>
                        <span asp-validation-for="IpNo" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="Description">Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="IP hakkında açıklama..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    
                    <button type="submit" class="btn btn-warning btn-icon-text mr-2 text-white"><i class="fa fa-edit btn-icon-prepend"></i> Güncelle</button>
                    <a asp-action="Index" class="btn btn-light btn-icon-text"><i class="fa fa-times btn-icon-prepend"></i> İptal</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}




