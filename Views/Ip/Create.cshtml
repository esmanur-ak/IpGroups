@model IpGroups.Models.ViewModels.IpViewModel

@{
    ViewData["Title"] = "IP Ekle";
}

<div class="row">
    <div class="col-md-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Yeni IP Bilgileri</h4>
                <p class="card-description">
                    Eklemek istediğiniz IP adresini ve açıklamasını giriniz.
                </p>
                <form class="forms-sample" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="form-group">
                        <label asp-for="IpNo">IP No</label>
                        <input type="text" asp-for="IpNo" class="form-control" placeholder="Örn: 192.168.1.100" required>
                        <span asp-validation-for="IpNo" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="Description">Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="IP hakkında açıklama..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    
                    <button type="submit" class="btn btn-primary btn-icon-text mr-2"><i class="fa fa-save btn-icon-prepend"></i> Kaydet</button>
                    <a asp-action="Index" class="btn btn-light btn-icon-text"><i class="fa fa-times btn-icon-prepend"></i> İptal</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}




